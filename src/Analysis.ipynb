   "cell_type": "raw",
   "id": "702758dd-9392-4bc5-af95-9ae5f8c80a22",
   "metadata": {},
   "source": [
    "#Creación de variable con ponderación general de rendimiento basado en condición en variable \"Average_Final\"\n",
    "Condition = [\n",
    "    (df[\"Average_Final\"] >=95),\n",
    "    (df[\"Average_Final\"] >=90) & (df[\"Average_Final\"] <95),\n",
    "    (df[\"Average_Final\"] >=80) & (df[\"Average_Final\"] <90),\n",
    "    (df[\"Average_Final\"] >=70) & (df[\"Average_Final\"] <80),\n",
    "    (df[\"Average_Final\"] <70)\n",
    "]\n",
    "\n",
    "Classes = [\n",
    "    \"Excellent\",\n",
    "    \"Potential\", \n",
    "    \"Outstanding\", \n",
    "    \"Enough\",\n",
    "    \"Deficient\"\n",
    "]\n",
    "df[\"Performance\"] = np.select(Condition, Classes, default=\"insuficiente\")\n",
    "df.head()"
   ]
  },
